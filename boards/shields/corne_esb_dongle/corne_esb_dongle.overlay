 *
 * Corne ESB Dongle：无按键的 USB 接收器（split central）。
 *
 * dongle 自己没有按键矩阵，所以用 zmk,kscan-mock 顶替 kscan；但 matrix transform
 * 和 physical layout 必须与左右手完全一致（连节点名都一样），central 才能把
 * peripheral 上报的 key position 正确映射成按键行为。
 * 下面的 transform / layout 复制自 ZMK 官方的 app/boards/shields/corne/corne.dtsi。
 *
 * ESB 地址不在这个文件里，而在 config/corne.overlay（三个固件共用一份）。
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/5column.dtsi>
#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_6col_layout {
    transform = <&default_transform>;
};

&foostan_corne_5col_layout {
    transform = <&five_column_transform>;
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &foostan_corne_6col_layout;
        // 想默认用 36 键（5 列）布局就换成：
        // zmk,physical-layout = &foostan_corne_5col_layout;
    };

    // dongle 没有实体按键
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
//                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    five_column_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  |
// | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  |
// | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 |
//               | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/*
 * === 鼠标（Lariska）===
 *
 * 鼠标在 ESB 网络里是一个 peripheral，两路信息分别走两条通道：
 *
 *  A. 指针移动 / 滚轮：input 事件
 *     鼠标把它自己的输入设备（paw3395、编码器）通过 zmk,input-split 上报，
 *     dongle 侧必须有 **reg 相同** 的 zmk,input-split 节点才能收到：
 *       - reg = 4 → 指针（鼠标固件 lariska.overlay 里的 mou0_split）
 *     收到以后由下面的 zmk,input-listener 接管，走 ZMK pointing 变成
 *     USB HID 鼠标报文。
 *
 *  B. 5 个鼠标按键：key position（键位事件）
 *     鼠标保持它原本的 gpio-direct kscan 不动，上报的是位置 0~4；
 *     dongle 侧的 config/corne.keymap 把这 5 个位置解释成
 *     LCLK / RCLK / MCLK / MB4 / MB5 —— 也就是说"鼠标按键"完全在
 *     keymap 里定义（Corne 自己的 42 键因此被挤到 5~46，见 config/corne.overlay）。
 *
 * 滚轮需要 dongle 侧存在一个 zmk,keymap-sensors 节点（数量与鼠标的传感器
 * 数量一致），下面的"占位编码器"就是干这个的。
 *
 * 另外 config/corne_esb_dongle.conf 里还要有：
 *      CONFIG_ZMK_POINTING=y / CONFIG_ZMK_INPUT_SPLIT=y
 *      CONFIG_ZMK_SPLIT_ESB_PERIPHERAL_COUNT > 鼠标的 PERIPHERAL_ID
 *      CONFIG_EC11=y / CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y
 */
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        /* 指针（paw3395）：鼠标固件里 mou0_split 的 reg = 4 */
        mouse_split: mouse_split@4 {
            compatible = "zmk,input-split";
            reg = <4>;
        };
    };

    mouse_listener: mouse_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&mouse_split>;

        // 需要修正方向 / 缩放时在这里加 input-processors，例如：
        // input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP
        //                                        | INPUT_TRANSFORM_X_INVERT)>;
    };

    /*
     * 占位编码器：dongle 自己没有滚轮，但 ZMK 的 zmk,keymap-sensors 必须指向
     * 真实的 sensor 设备；鼠标上报的 sensor 事件（index 0）会按这个顺序匹配到
     * config/corne.keymap 每层的 sensor-bindings（&rot_enc / 音量）。
     * 这里挂在 P0.09/P0.10 上 —— nice_nano 的 NFC 引脚，Corne 用不到，
     * 悬空也不会有任何输入，纯占位。
     */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <24>;
    };
};

/* P0.09 / P0.10 默认是 NFC 天线脚，要当 GPIO 用必须先声明 */
&uicr {
    nfct-pins-as-gpios;
};
